# ── Base de datos ─────────────────────────────────────────────
# Producción: cualquier PostgreSQL 14+ con las extensiones pg_trgm y unaccent
# (Neon, Supabase, RDS, Railway...). Si se deja vacío, MemeDesk usa PGlite
# (PostgreSQL embebido en WASM) guardado en ./data/pglite — ideal para desarrollo.
DATABASE_URL=
# Conexiones por proceso (en Vercel conviene 3)
DATABASE_POOL_SIZE=10

# ── Almacenamiento de imágenes ───────────────────────────────
# "local" guarda en ./data/uploads. "s3" usa cualquier servicio compatible con S3
# (AWS S3, Cloudflare R2, Backblaze B2, MinIO...).
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL pública del bucket/CDN (opcional). Si se omite, las imágenes se sirven vía /files/...
# (recomendado: así ocultar un meme lo saca de línea al instante).
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true

# ── Panel de administración (Basic Auth) ─────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=cambiame

# ── Importación automática ───────────────────────────────────
# "inprocess": el planificador corre dentro del servidor web (obligatorio con PGlite).
# "off": el servidor no importa; usá `npm run worker`, el endpoint /api/cron/import o GitHub Actions.
# En Vercel el valor por defecto es "off".
IMPORT_SCHEDULER=inprocess
# Publicar al instante lo importado (false = queda pendiente de revisión en el panel)
IMPORT_AUTO_PUBLISH=true
# Máximo de memes nuevos por fuente y ejecución
IMPORT_MAX_PER_RUN=60
# Leer el texto de cada imagen con OCR (tesseract.js) para que sea buscable
IMPORT_OCR=true
# Palabras extra que hacen descartar un post (coma)
IMPORT_BLOCKLIST=
# Identificación del bot ante las fuentes (poné una URL o email de contacto)
IMPORT_USER_AGENT=MemeDeskBot/1.0 (+https://github.com/marvainstein/memecorp)
# Secreto para /api/cron/import (Vercel Cron, GitHub Actions...): Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Reddit — API oficial (crear app tipo "script" en https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Pinterest — API oficial v5 (https://developers.pinterest.com/), scopes boards:read y pins:read
PINTEREST_ACCESS_TOKEN=

# ── Moderación ────────────────────────────────────────────────
# Ocultar automáticamente un meme cuando acumula N reportes abiertos (0 = desactivado)
REPORT_AUTOHIDE_THRESHOLD=3
# Tamaño máximo por imagen en MB
MAX_UPLOAD_MB=15

# URL pública del sitio (para enlaces de compartir y Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
